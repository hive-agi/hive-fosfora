{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure   {:mvn/version "1.12.6"}
  org.clojure/data.json {:mvn/version "2.5.2"}

  ;; The IAddon contract, not the host: any host can mount this jar.
  io.github.hive-agi/hive-addon {:mvn/version "1.1.2"}

  ;; Result values.
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.34"}}

 :aliases
 {:build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
          :ns-default hive-build.api}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}

  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                       cider/cider-nrepl {:mvn/version "0.62.2"}}
          :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}

 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}}
