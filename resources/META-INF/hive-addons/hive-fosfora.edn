{:addon/id           "hive.fosfora"
 :addon/kind         :addon
 :addon/type         :external
 :addon/version      "0.1.0"
 :addon/init-ns      "hive-fosfora.addon"
 :addon/init-fn      "addon-ctor"
 :addon/config       {}
 :addon/capabilities #{:tools :health-reporting}
 :addon/dependencies #{}
 :addon/lifecycle    {:policy :lazy :idle-ms 900000}
